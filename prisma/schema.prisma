generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Character {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  personality String
  createdAt   DateTime @default(now())
}
